# ==============================================================================
# GOLD QUANT AI — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
# ==============================================================================

# --- Global ---
GOLD_ENVIRONMENT=development          # development | testing | demo | production
GOLD_PROJECT_NAME="GOLD QUANT AI"
GOLD_LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gold_quant_ai
POSTGRES_USER=gold_quant_ai
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=20

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_TRADING_GROUP_ID=
TELEGRAM_RESEARCH_GROUP_ID=

# --- MetaTrader 5 ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_ACCOUNT_TYPE=demo                 # demo | live  (live requires explicit approval, see FAILSAFE_PROTOCOL.md)

# --- Market / News Data Providers (fill in as sources are approved) ---
FRED_API_KEY=
TRADINGECONOMICS_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
NEWSAPI_API_KEY=
OPENAI_API_KEY=

# --- Security ---
SECRET_KEY=changeme-generate-a-random-64-char-secret
ENCRYPTION_KEY=changeme-generate-a-fernet-key

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=changeme
